{
  "manifest_version": 3,
  "name": "Reference Capture Lab",
  "version": "0.1.0",
  "description": "User-invoked local capture test. Save the current page and a visible preview; no tracking or automatic X API calls.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Save this page to the local capture lab"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Save the current page"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765 data:"}
}
