{
  "manifest_version": 3,
  "name": "Reference Library",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Save references and optionally keep X bookmark folders up to date while Chrome is open.",
  "optional_host_permissions": ["https://x.com/*"],
  "optional_permissions": ["idle"],
  "options_ui": {"page":"options.html","open_in_tab":true},
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://tquryxcyrvgwchbxyrmk.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save this page to your private library"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Save the current page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://tquryxcyrvgwchbxyrmk.supabase.co data:"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bookmark-app-nu-seven.vercel.app/*"
      ],
      "js": [
        "connect.js"
      ]
    }
  ]
}
